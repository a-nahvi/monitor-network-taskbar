210 DIALOGEX 0, 0, 326, 249
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NetBar settings"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "NetBar", 215, 15, 8, 130, 19
  RTEXT "", 216, 197, 14, 114, 11
  CONTROL "", 217, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 12, 34, 302, 180

  LTEXT "Display", 301, 25, 65, 83, 11
  COMBOBOX 302, 118, 63, 106, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Graph width", 303, 25, 83, 90, 11
  EDITTEXT 304, 118, 81, 41, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "px", 305, 163, 83, 20, 11
  LTEXT "Text size", 306, 25, 101, 83, 11
  COMBOBOX 307, 118, 99, 106, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Text color", 308, 25, 119, 83, 11
  COMBOBOX 309, 118, 117, 106, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "Upload color…", 310, 25, 139, 71, 14
  PUSHBUTTON "Download color…", 311, 101, 139, 83, 14
  PUSHBUTTON "Default colors", 312, 189, 139, 73, 14
  AUTOCHECKBOX "Show on taskbar", 313, 25, 163, 95, 12, WS_TABSTOP
  AUTOCHECKBOX "Lock position", 314, 131, 163, 83, 12, WS_TABSTOP
  PUSHBUTTON "Reset position", 315, 223, 162, 73, 14
  AUTOCHECKBOX "Start with Windows", 316, 25, 184, 111, 12, WS_TABSTOP

  LTEXT "Network adapter", 401, 25, 65, 86, 11
  COMBOBOX 402, 118, 63, 178, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Speed units", 403, 25, 90, 83, 11
  COMBOBOX 404, 118, 88, 137, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Refresh every", 405, 25, 115, 83, 11
  COMBOBOX 406, 118, 113, 106, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  AUTOCHECKBOX "Show app traffic on hover", 407, 25, 144, 200, 12, WS_TABSTOP
  LTEXT "Windows may require administrator access to measure app traffic.", 408, 25, 167, 258, 23

  PUSHBUTTON "Check for updates", 501, 25, 65, 93, 15
  PUSHBUTTON "Install update", 502, 123, 65, 86, 15
  LTEXT "", 503, 25, 86, 270, 29
  GROUPBOX "GitHub access", 504, 22, 119, 280, 83
  LTEXT "Repository", 505, 31, 134, 70, 11
  EDITTEXT 506, 111, 131, 181, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
  LTEXT "Read-only token", 507, 31, 153, 75, 11
  EDITTEXT 508, 111, 150, 181, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
  PUSHBUTTON "Save access", 509, 111, 173, 74, 15
  PUSHBUTTON "Clear token", 510, 190, 173, 73, 15

  PUSHBUTTON "Restore defaults", 218, 12, 224, 87, 15
  DEFPUSHBUTTON "Save", IDOK, 198, 224, 55, 15
  PUSHBUTTON "Cancel", IDCANCEL, 259, 224, 55, 15
END
